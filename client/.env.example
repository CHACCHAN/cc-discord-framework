# 環境変数の見本。`.env` にコピーして使ってください。
#
# ここの並びは `config/` のファイルに対応しています
# (client / utils / music / ai)。どの変数がどの設定で使われるかは、
# 対応する `config/*.ts` を見れば分かります。
#
# **環境変数を読んでいるのは `src/config/_env.ts` の1ファイルだけです。**
# 変数を足すときも、まずあのファイルに読み出しを書いて、設定ファイルは
# そこから受け取ってください(`Bun.env` を設定ファイルやコンポーネントに
# 散らさないための約束です)。唯一の例外が下の DISCORD_TOKEN で、これは
# discord.js が `login()` の中で自分で読みます。

# ---- client(config/client.ts)---------------------------------------------

# Bot のトークン(必須)
# フレームワークではなく discord.js が直接読むので、src/config/_env.ts には
# 出てきません。
DISCORD_TOKEN=your-bot-token

# /shutdown を実行できるユーザー ID(カンマ区切り)
# src/config/_env.ts → src/services/ConfigService.ts 経由で、
# どのコンポーネントからも this.services.config.ownerIds で参照できます。
OWNER_IDS=

# 開発用ギルド ID(カンマ区切り)。設定するとスラッシュコマンドが即時反映される。
DEV_GUILD_IDS=

# ---- utils(config/utils.ts)-----------------------------------------------
# 環境変数はありません。定期実行・確認 UI・ページ送り・整形の設定
# (テーマなど)は config/utils.ts に直接書きます。

# ---- music(config/music.ts)-----------------------------------------------

# SoundCloud の client_id(任意)。
# 未設定でも自動抽出されるが、数か月で失効することがあるため
# 安定させたい場合はブラウザの開発者ツールで取得した値を入れる。
SOUNDCLOUD_CLIENT_ID=

# ---- ai(config/ai.ts)-----------------------------------------------------
# 未設定でも Bot は普通に起動する。その場合 /ask・/chat だけが
# 「モデルを設定してください」と答える(他の機能には影響しない)。
#
# "<プロバイダー>:<モデルID>" の形で書く。使うプロバイダーのパッケージを
# bun add してから設定すること(入れていないと、その旨のエラーが返る)。
#
#   google:gemini-2.5-flash  → bun add @ai-sdk/google      (無料枠あり・おすすめ)
#   openai:gpt-5             → bun add @ai-sdk/openai
#   anthropic:claude-sonnet-4-5 → bun add @ai-sdk/anthropic
#
#   compatible:<モデルID>     → bun add @ai-sdk/openai-compatible
#                                (OpenAI 互換 API: Open WebUI / Ollama /
#                                 LM Studio / vLLM / OpenRouter など)
AI_MODEL=

# ---- OpenAI 互換エンドポイント(AI_MODEL が compatible:… のとき)--------
# 接続先。/chat/completions の手前まで(例: https://example.com/api)。
# AI_MODEL が compatible:… なのにここが空だと、その組み合わせでは動かない
# ので、起動時に src/config/_env.ts が警告を出す。
AI_BASE_URL=

# 認証トークン。Authorization: Bearer として送られる。
# **認証を掛けているエンドポイントでは必須** — 空だと 401 になる。
# ローカルの Ollama のように認証が無い相手なら空でよい。
AI_TOKEN=

# ---- AI ツール(src/ai/)--------------------------------------------------
# 既定では src/ai/ のツールをモデルへ渡す。
# **モデルが function calling に対応していない場合は off にすること。**
# 対応していない相手にツールを渡すと、エラーも出さずに空の応答が返るため、
# Bot は「応答がありませんでした。」しか言えなくなる。
# (そのときログに「ツールを渡しています」という警告が出る)
#
# 無効にする値: off / false / 0 / no
# 有効にする値: on / true / 1 / yes(空なら有効)
# どちらとも解釈できない値を書くと、既定のまま + 起動時に警告が出る。
AI_TOOLS=

# ---- 公式プロバイダーの API キー -----------------------------------------
# 各 SDK が既定で読む環境変数をそのまま使う。
# 上で選んだプロバイダーのものだけ設定すればよい。
# 無料で試すなら Google AI Studio でキーを取るのが手軽。
# (これらは SDK が直接読むので src/config/_env.ts には出てこない)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
