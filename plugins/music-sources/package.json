{
  "name": "@cc-discord-framework/music-sources",
  "version": "1.0.0",
  "license": "MIT",
  "description": "cc-discord-framework 公式プラグイン: music プラグイン向けの音源(YouTube・SoundCloud)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHACCHAN/cc-discord-framework.git",
    "directory": "plugins/music-sources"
  },
  "homepage": "https://discord-framework.oss.cc-chacchan.com",
  "bugs": "https://github.com/CHACCHAN/cc-discord-framework/issues",
  "author": "CHACCHAN",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run clean && bun run build"
  },
  "dependencies": {
    "soundcloud.ts": "^0.7.4",
    "youtubei.js": "^18.0.0"
  },
  "peerDependencies": {
    "@cc-discord-framework/music": "^1.0.0",
    "@cc-discord-framework/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
