{
    "name": "cc-discord-framework-dev",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": false
        },
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24"
        },
        "ghcr.io/devcontainers-extra/features/bun:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/apt-packages:1": {
            "packages": "vim,bubblewrap,ffmpeg,ripgrep,fd-find,fzf,tmux,dnsutils,netcat-openbsd,shellcheck,build-essential,python3"
        },
        "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {},
        "ghcr.io/devcontainers-extra/features/npm-packages:1": {
            "packages": "@openai/codex"
        },
        "ghcr.io/thediveo/devcontainer-features/lazygit:0": {}
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "workspaceFolder": "/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
        "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.gemini,target=/home/vscode/.gemini,type=bind,consistency=cached"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "editorconfig.editorconfig",
                "streetsidesoftware.code-spell-checker",
                "gruntfuss.vscode-nginx-conf-hint",
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "mikestead.dotenv",
                "pkief.material-icon-theme",
                "Prisma.prisma",
                "biomejs.biome",
                "oven.bun-vscode",
                "usernamehw.errorlens",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll.biome": "explicit",
                    "source.organizeImports.biome": "explicit"
                },
                "[typescript]": {
                    "editor.defaultFormatter": "biomejs.biome"
                },
                "[javascript]": {
                    "editor.defaultFormatter": "biomejs.biome"
                },
                "[json]": {
                    "editor.defaultFormatter": "biomejs.biome"
                },
                "[jsonc]": {
                    "editor.defaultFormatter": "biomejs.biome"
                },
                "[prisma]": {
                    "editor.defaultFormatter": "Prisma.prisma"
                },
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true
            }
        }
    }
}
