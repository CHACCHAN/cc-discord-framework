{
  "name": "@cc-discord-framework/core",
  "version": "2.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHACCHAN/cc-discord-framework.git"
  },
  "description": "A modern Discord framework specifically for Bun",
  "homepage": "https://discord-framework.oss.cc-chacchan.com",
  "bugs": "https://github.com/CHACCHAN/cc-discord-framework/issues",
  "author": "CHACCHAN",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "framework",
    "bun"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CONTRIBUTING.md",
    "SUPPORT.md"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "client",
    "plugins/*",
    "website"
  ],
  "scripts": {
    "link:self": "bun run scripts/link-self.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run clean && bun run build",
    "website:dev": "bun run --cwd website start",
    "website:build": "bun run --cwd website build",
    "website:preview": "bun run --cwd website serve"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
