{
  "name": "cc-discord-framework",
  "version": "1.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHACCHAN/cc-discord-framework.git"
  },
  "description": "My custom Discord.js framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "require": "./dist/modules/index.js"
    }
  },
  "private": false,
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "glob": "^13.0.6",
    "play-dl": "^1.9.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "discord.js": "^14.26.3"
  }
}
