{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./core",
    "declaration": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "core/**/*"
  ],
  "exclude": [
    "node_modules",
    "src",
    "**/*.spec.ts"
  ]
}