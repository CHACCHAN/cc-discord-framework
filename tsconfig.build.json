{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./core",
    "outDir": "./dist",
    "rootDir": "./core",
    "paths": {
      "@core/*": ["*"],
      "@core/containersType": ["types/ContainersType"],
      "@core/cacheType": ["types/CacheType"],
    },
    "declaration": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["core/**/*"],
  "exclude": [
    "node_modules",
    "src",
    "**/*.spec.ts"
  ]
}